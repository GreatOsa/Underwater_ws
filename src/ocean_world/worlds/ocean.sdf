<?xml version="1.0" ?>

<sdf version="1.7">

  <world name="ocean">

    <!-- ================================================= -->
    <!-- UNDERWATER ATMOSPHERE -->
    <!-- ================================================= -->

    <scene>

      <!-- General underwater illumination -->
      <ambient>0.035 0.12 0.18 1</ambient>

      <!-- Deep ocean background -->
      <background>0.002 0.018 0.035 1</background>

      <shadows>false</shadows>

      <!-- Underwater visibility / blue depth -->
      <fog>
        <type>linear</type>
        <color>0.01 0.08 0.14 1</color>

        <!-- Objects nearby remain clear -->
        <start>6</start>

        <!-- Distant objects fade into blue -->
        <end>40</end>
      </fog>

    </scene>


    <!-- ================================================= -->
    <!-- PHYSICS -->
    <!-- ================================================= -->

    <physics name="1ms" type="ignored">

      <max_step_size>0.001</max_step_size>

      <real_time_factor>1.0</real_time_factor>

    </physics>


    <!-- ================================================= -->
    <!-- GAZEBO SYSTEMS -->
    <!-- ================================================= -->

    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>

    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>

    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>


    <!-- ================================================= -->
    <!-- MAIN SUNLIGHT -->
    <!-- ================================================= -->

    <light
      type="directional"
      name="underwater_sun">

      <cast_shadows>false</cast_shadows>

      <pose>0 0 25 0 0 0</pose>

      <!-- Strong blue-white sunlight -->
      <diffuse>0.55 0.80 0.88 1</diffuse>

      <specular>0.10 0.18 0.22 1</specular>

      <direction>
        -0.25
        0.15
        -1
      </direction>

    </light>


    <!-- ================================================= -->
    <!-- SURFACE LIGHT -->
    <!-- ================================================= -->

    <!--
      Simulates strong light entering from above.
      This gives the upper part of the scene more energy.
    -->

    <light
      type="directional"
      name="surface_light">

      <cast_shadows>false</cast_shadows>

      <pose>0 0 18 0 0 0</pose>

      <diffuse>0.40 0.75 0.88 1</diffuse>

      <specular>0.08 0.16 0.20 1</specular>

      <direction>
        0.05
        -0.08
        -1
      </direction>

    </light>


    <!-- ================================================= -->
    <!-- UNDERWATER FILL LIGHT -->
    <!-- ================================================= -->

    <light
      type="directional"
      name="underwater_fill">

      <cast_shadows>false</cast_shadows>

      <pose>-15 10 12 0 0 0</pose>

      <diffuse>0.06 0.22 0.30 1</diffuse>

      <specular>0.01 0.03 0.04 1</specular>

      <direction>
        0.35
        -0.20
        -1
      </direction>

    </light>


    <!-- ================================================= -->
    <!-- SOFT SUNBEAM 1 -->
    <!-- ================================================= -->

    <light
      type="spot"
      name="sunbeam_1">

      <pose>-12 -8 12 0.20 -0.15 0.15</pose>

      <cast_shadows>false</cast_shadows>

      <diffuse>0.12 0.45 0.58 1</diffuse>

      <specular>0.02 0.05 0.07 1</specular>

      <direction>
        0.15
        0.10
        -1
      </direction>

      <spot>

        <inner_angle>0.18</inner_angle>

        <outer_angle>0.48</outer_angle>

        <falloff>0.50</falloff>

      </spot>

    </light>


    <!-- ================================================= -->
    <!-- SOFT SUNBEAM 2 -->
    <!-- ================================================= -->

    <light
      type="spot"
      name="sunbeam_2">

      <pose>0 -12 14 0.15 0.10 0</pose>

      <cast_shadows>false</cast_shadows>

      <diffuse>0.10 0.40 0.55 1</diffuse>

      <specular>0.02 0.04 0.06 1</specular>

      <direction>
        -0.10
        0.05
        -1
      </direction>

      <spot>

        <inner_angle>0.16</inner_angle>

        <outer_angle>0.45</outer_angle>

        <falloff>0.55</falloff>

      </spot>

    </light>


    <!-- ================================================= -->
    <!-- SOFT SUNBEAM 3 -->
    <!-- ================================================= -->

    <light
      type="spot"
      name="sunbeam_3">

      <pose>12 5 13 -0.10 0.15 0</pose>

      <cast_shadows>false</cast_shadows>

      <diffuse>0.10 0.42 0.58 1</diffuse>

      <specular>0.02 0.05 0.07 1</specular>

      <direction>
        -0.15
        -0.05
        -1
      </direction>

      <spot>

        <inner_angle>0.18</inner_angle>

        <outer_angle>0.50</outer_angle>

        <falloff>0.50</falloff>

      </spot>

    </light>


    <!-- ================================================= -->
    <!-- SEABED -->
    <!-- ================================================= -->

    <model name="seabed">

      <static>true</static>

      <link name="seabed_link">


        <!-- ============================================= -->
        <!-- COLLISION -->
        <!-- ============================================= -->

        <collision name="collision">

          <geometry>

            <mesh>

              <uri>file://meshes/seabed.obj</uri>

            </mesh>

          </geometry>

        </collision>


        <!-- ============================================= -->
        <!-- VISUAL -->
        <!-- ============================================= -->

        <visual name="visual">

          <geometry>

            <mesh>

              <uri>file://meshes/seabed.obj</uri>

            </mesh>

          </geometry>


          <!-- Slight warm sand colour -->
          <material>

            <ambient>
              0.16 0.14 0.06 1
            </ambient>

            <diffuse>
              0.45 0.38 0.16 1
            </diffuse>

            <specular>
              0.02 0.02 0.01 1
            </specular>

          </material>

        </visual>

      </link>

    </model>


    <!-- ================================================= -->
    <!-- UNDERWATER DECORATIONS -->
    <!-- ================================================= -->

    <!--
      Existing decoration system.

      Contains:
        1000 tiny seaweed
        100 rocks

      Keep this file separate.
    -->

    <include>

      <uri>file://models/decorations/model.sdf</uri>

      <name>underwater_decorations</name>

    </include>


  </world>

</sdf>