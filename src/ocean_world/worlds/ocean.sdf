<?xml version="1.0"?>
<sdf version="1.8">
  <world name="ocean">

    <scene>
      <ambient>0.08 0.18 0.28 1</ambient>
      <background>0.01 0.05 0.10 1</background>
      <shadows>false</shadows>

      <fog>
        <type>linear</type>
        <color>0.02 0.12 0.20 1</color>
        <start>15</start>
        <end>80</end>
      </fog>
    </scene>

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>

    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>

    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>


    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>

      <pose>0 0 30 0 0 0</pose>

      <diffuse>0.35 0.65 0.75 1</diffuse>
      <specular>0.05 0.10 0.12 1</specular>

      <direction>-0.4 0.2 -1</direction>
    </light>

    <!-- Seabed -->
    <!-- <include>
      <uri>model://seabed</uri>
    </include>   -->
    <!-- Seabed -->

    <!-- SEABED MESH -->
    <model name="seabed">

      <static>true</static>

      <link name="seabed_link">

        <!-- Collision -->
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>file://meshes/seabed.obj</uri>
            </mesh>
          </geometry>
        </collision>

        <!-- Visual -->
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>file://meshes/seabed.obj</uri>
            </mesh>
          </geometry>
        </visual>

      </link>

    </model>

    <!-- OCEAN SURFACE -->
    <model name="ocean_surface">
      <static>true</static>
      <pose>0 0 8 0 0 0</pose>
      <link name="surface_link">
        <visual name="surface_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.18 0.25 1</ambient>
            <diffuse>0.02 0.25 0.35 1</diffuse>
            <specular>0.4 0.5 0.5 1</specular>
            <transparency>0.35</transparency>
          </material>
        </visual>
      </link>
    </model>



  </world>
</sdf>